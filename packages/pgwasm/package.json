{
  "name": "@pgxsinkit/pgwasm",
  "version": "0.0.0",
  "keywords": [
    "tanstack-intent"
  ],
  "license": "MIT AND Apache-2.0",
  "files": [
    "dist",
    "src",
    "skills",
    "README.md",
    "LICENSE",
    "LICENSE-APACHE-2.0",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "browser": {
    "fs": false,
    "node:fs": false
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "default": "./dist/build/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle/index.d.ts",
      "default": "./dist/drizzle/index.js"
    },
    "./fs": {
      "types": "./dist/fs/index.d.ts",
      "default": "./dist/fs/index.js"
    },
    "./live": {
      "types": "./dist/live/index.d.ts",
      "default": "./dist/live/index.js"
    },
    "./opfs": {
      "types": "./dist/opfs/index.d.ts",
      "default": "./dist/opfs/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun --cwd ../.. run build:public-packages"
  },
  "peerDependencies": {
    "drizzle-orm": "1.0.0-rc.4"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  }
}
