{
  "name": "@pgxsinkit/pgwasm-c",
  "version": "0.0.0",
  "private": true,
  "license": "PostgreSQL",
  "files": [
    "artefacts",
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "browser": {
    "crypto": false,
    "fs": false,
    "module": false,
    "node:fs": false,
    "node:path": false,
    "path": false,
    "url": false,
    "ws": false
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contrib/amcheck": {
      "types": "./dist/contrib/amcheck.d.ts",
      "default": "./dist/contrib/amcheck.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun --cwd ../.. run build:public-packages"
  },
  "peerDependencies": {
    "@pgxsinkit/pgwasm": "workspace:*"
  }
}
