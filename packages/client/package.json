{
  "name": "@pgxsinkit/client",
  "version": "0.0.0",
  "keywords": [
    "tanstack-intent"
  ],
  "license": "MIT AND Apache-2.0",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "LICENSE-APACHE-2.0",
    "NOTICE",
    "skills",
    "oxlint-plugin.js"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "browser": {
    "fs": false,
    "node:fs": false
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./oxlint": "./oxlint-plugin.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun --cwd ../.. run build:public-packages"
  },
  "dependencies": {
    "@pgxsinkit/contracts": "workspace:*",
    "@pgxsinkit/pgwasm": "workspace:*",
    "@pgxsinkit/pgwasm-c": "workspace:*",
    "@pgxsinkit/pgwasm-pg-dump": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": "1.0.0-rc.4",
    "zod": "^4.6.5"
  }
}
