{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedSideEffectImports": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "jsx": "react-jsx",
    "paths": {
      "drizzle-orm": ["./node_modules/drizzle-orm"],
      "drizzle-orm/*": ["./node_modules/drizzle-orm/*"],
      "@pgxsinkit/client": ["./packages/client/src/index.ts"],
      "@pgxsinkit/client/testing": ["./packages/client/src/testing.ts"],
      "@pgxsinkit/board-schema": ["./packages/board-schema/src/index.ts"],
      "@pgxsinkit/schema": ["./packages/schema/src/index.ts"],
      "@pgxsinkit/contracts": ["./packages/contracts/src/index.ts"],
      "@pgxsinkit/pglite-opfs-repacked": ["./packages/pglite-opfs-repacked/src/index.ts"],
      "@pgxsinkit/pgwasm": ["./packages/pgwasm/src/index.ts"],
      "@pgxsinkit/pgwasm/build": ["./packages/pgwasm/src/build/index.ts"],
      "@pgxsinkit/pgwasm/drizzle": ["./packages/pgwasm/src/drizzle/index.ts"],
      "@pgxsinkit/pgwasm/fs": ["./packages/pgwasm/src/fs/index.ts"],
      "@pgxsinkit/pgwasm/live": ["./packages/pgwasm/src/live/index.ts"],
      "@pgxsinkit/pgwasm/opfs": ["./packages/pgwasm/src/opfs/index.ts"],
      "@pgxsinkit/pgwasm/protocol": ["./packages/pgwasm/src/protocol/index.ts"],
      "@pgxsinkit/pgwasm-c": ["./packages/pgwasm-c/src/index.ts"],
      "@pgxsinkit/pgwasm-c/contrib/amcheck": ["./packages/pgwasm-c/src/contrib/amcheck.ts"],
      "@pgxsinkit/pgwasm-c/prepopulated": ["./packages/pgwasm-c/src/prepopulated.ts"],
      "@pgxsinkit/pgwasm-pg-dump": ["./packages/pgwasm-pg-dump/src/index.ts"],
      "@pgxsinkit/pgwasm-repl": ["./packages/pgwasm-repl/src/index.ts"],
      "@pgxsinkit/server": ["./packages/server/src/index.ts"],
      "@pgxsinkit/test-utils": ["./packages/test-utils/src/index.ts"],
      "@pgxsinkit/react": ["./packages/react/src/index.ts"]
    }
  }
}
