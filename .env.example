DATABASE_URL=postgresql://supabase_admin:your-super-secret-and-long-postgres-password@localhost:54321/postgres?sslmode=disable
WRITE_API_PORT=3001
# Enable/disable server-side operations logging. Restart the API process after changing.
WRITE_API_OPS_LOG_ENABLED=true
VITE_WRITE_API_ORIGIN=http://localhost:3001
NPM_CONFIG_TOKEN=npm_your-npm-token-goes-here

# The native read path. OPTIONAL — every container lane (`test:integration:*`, `infra:harness:up`)
# DERIVES this from the registries it exercises, so a fresh clone needs nothing set here.
#
# The engine's EXPLICIT table list — never `*`, which introspects every `public` table that has a
# primary key and replicates all of them, the operations log included, giving each one REPLICA
# IDENTITY FULL (pgmq is untouched either way: it is non-relocatable in schema `pgmq`, which the
# engine never looks at). Set this only to point a lane at a different table set; the derived value
# is the union of the tables the lane registries declare:
# PGXSINKIT_CIRCUITS_PG_TABLES=authors,fk_children,fk_parents,projects,rls_todos,todos,work_items,workspace_members,workspaces

# Optional. The engine runs a published image of the pgxsinkit fork of electric-circuits, pinned by
# sha tag in the compose files; set this only to point a lane at a local engine build.
# PGXSINKIT_CIRCUITS_ENGINE_IMAGE=localhost/electric-circuits-engine:dev
