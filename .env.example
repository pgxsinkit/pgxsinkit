DATABASE_URL=postgresql://supabase_admin:your-super-secret-and-long-postgres-password@localhost:54321/postgres?sslmode=disable
WRITE_API_PORT=3001
# Enable/disable server-side operations logging. Restart the API process after changing.
WRITE_API_OPS_LOG_ENABLED=true
VITE_WRITE_API_ORIGIN=http://localhost:3001
NPM_CONFIG_TOKEN=npm_your-npm-token-goes-here

# The native read path. Both are REQUIRED by every container lane (`test:integration:*`,
# `infra:harness:up`) — the runners refuse to start without them.
#
# The engine image is built from the electric-circuits Dockerfile, so this must point at a checkout.
PGXSINKIT_CIRCUITS_REPO=/path/to/electric-circuits
# The engine's EXPLICIT table list — never `*`, which introspects every public table with a primary
# key and sweeps in the operations log and pgmq's own relations (docs/research/0001). This is every
# table declared by the registries the integration lanes exercise; keep it in step with them.
PGXSINKIT_CIRCUITS_PG_TABLES=authors,fk_children,fk_parents,projects,rls_todos,todos,work_items,workspace_members,workspaces
